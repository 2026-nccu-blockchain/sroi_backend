APP_NAME=SROI Backend
APP_VERSION=0.1.0
ENVIRONMENT=local
SROI_DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=60
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sroi"
MAX_REQUESTS=100
WINDOW_SECONDS=60
